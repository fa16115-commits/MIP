{
  "buildCommand":"npm run build","outputDirectory":"public",
  "rewrites":[{"source":"/api/:path*","destination":"/api/index"},{"source":"/((?!api/|assets/).*)","destination":"/index.html"}],
  "functions":{"api/index.js":{"maxDuration":60}},
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Cache-Control","value":"private, no-store"},
    {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
  ]}]
}
